{%- style -%}
  .custom-about-stats-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
  }

  .custom-about-stats__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .custom-about-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    text-align: left;
  }

  @media screen and (min-width: 768px) {
    .custom-about-stats__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }
  }

  .custom-about-stats__item {
    border-left: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.2 }};
    padding-left: 16px;
  }

  .custom-about-stats__value {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 400;
    line-height: 1;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
    color: {{ section.settings.text_color }};
  }

  .custom-about-stats__label {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.15em;
    opacity: 0.75;
    font-weight: 600;
  }
{%- endstyle -%}

<div class="custom-about-stats-{{ section.id }}">
  <div class="custom-about-stats__container">
    <div class="custom-about-stats__grid">
      {%- for block in section.blocks -%}
        <div class="custom-about-stats__item" {{ block.shopify_attributes }}>
          {%- if block.settings.value != blank -%}
            <div class="custom-about-stats__value">{{ block.settings.value }}</div>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <div class="custom-about-stats__label">{{ block.settings.label }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Impact Stats",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A0E17"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Stat Value",
          "default": "100%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Handcrafted"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Impact Stats",
      "blocks": [
        {
          "type": "stat_item",
          "settings": {
            "value": "100%",
            "label": "Artisanal Handcraft"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "value": "15+",
            "label": "Master Craftsmen"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "value": "30 Yrs",
            "label": "Atelier Heritage"
          }
        },
        {
          "type": "stat_item",
          "settings": {
            "value": "0%",
            "label": "Carbon Footprint"
          }
        }
      ]
    }
  ]
}
{% endschema %}
