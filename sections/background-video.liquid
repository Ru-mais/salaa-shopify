{%- style -%}
  .background-video-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.mobile_height }}vh;
    height: {{ section.settings.mobile_height }}vh;
    overflow: hidden;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: {{ section.settings.content_vertical_alignment }};
    justify-content: {{ section.settings.content_horizontal_alignment }};
    background-color: #0b0b0b;
  }

  @media screen and (min-width: 750px) {
    .background-video-wrapper-{{ section.id }} {
      min-height: {{ section.settings.desktop_height }}vh;
      height: {{ section.settings.desktop_height }}vh;
    }
  }

  .background-video__media-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .background-video-wrapper-{{ section.id }} video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .background-video__poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .background-video__overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
    pointer-events: none;
  }

  .background-video__content {
    position: relative;
    z-index: 3;
    padding: 40px 24px;
    max-width: 900px;
    text-align: {{ section.settings.text_alignment }};
    color: #ffffff;
    pointer-events: auto;
  }

  .background-video__subtitle {
    display: block;
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 16px;
    opacity: 0.9;
  }

  .background-video__title {
    font-size: clamp(32px, 5.5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 24px;
    color: #ffffff;
    text-transform: uppercase;
  }

  .background-video__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    padding-bottom: 6px;
    transition: all 0.3s ease;
  }

  .background-video__cta:hover {
    border-bottom-color: #ffffff;
    letter-spacing: 0.22em;
  }

  .background-video__cta-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .background-video__cta:hover .background-video__cta-arrow {
    transform: translateX(4px);
  }
{%- endstyle -%}

<div class="background-video-wrapper-{{ section.id }}">
  <div class="background-video__media-container">
    {%- if section.settings.poster_image != blank -%}
      {{
        section.settings.poster_image
        | image_url: width: 2500
        | image_tag:
          class: 'background-video__poster',
          widths: '750, 1100, 1500, 2000, 2500',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.title | default: 'Video background'
      }}
    {%- endif -%}

    {%- if section.settings.video != blank -%}
      {%- assign video_html = section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2000x' -%}
      {{ video_html | replace: '<video', '<video playsinline' }}
    {%- elsif section.settings.poster_image == blank -%}
      <div style="color: rgba(255,255,255,0.7); font-family: sans-serif; text-align: center; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;">
        <p style="font-size: 12px; letter-spacing: 2px; text-transform: uppercase;">Background Video Section</p>
        <p style="font-size: 14px; opacity: 0.8;">Select a video or poster image in Theme Editor</p>
      </div>
    {%- endif -%}
  </div>

  <div class="background-video__overlay-{{ section.id }}" aria-hidden="true"></div>

  {%- if section.settings.subtitle != blank or section.settings.title != blank or section.settings.cta_label != blank -%}
    <div class="background-video__content">
      {%- if section.settings.subtitle != blank -%}
        <span class="background-video__subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="background-video__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="background-video__cta" aria-label="{{ section.settings.cta_label | escape }}">
          <span>{{ section.settings.cta_label }}</span>
          <span class="background-video__cta-arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Background Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Autoplays muted on continuous loop across desktop and mobile."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster / Fallback Image",
      "info": "Displays instantly while the video buffers, or on low-bandwidth / power-saving devices."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Editorial Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle / Collection Category",
      "default": "Autumn / Winter 2026"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Modern Silhouette"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Discover Collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop Height",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile Height",
      "default": 85
    },
    {
      "type": "select",
      "id": "content_horizontal_alignment",
      "label": "Horizontal Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Background Video"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
