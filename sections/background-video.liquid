<style>
  .background-video-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 100vh; /* Fits exact screen height */
    overflow: hidden;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
  }
  .background-video-wrapper-{{ section.id }} a.background-video__link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    display: block;
    cursor: pointer;
  }
  .background-video-wrapper-{{ section.id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* Crops and fills the screen */
    pointer-events: none; /* Prevents user interaction, hiding controls completely */
  }
</style>

<div class="background-video-wrapper-{{ section.id }}">
  {%- assign video_link = section.settings.link | default: 'shopify://collections/all' -%}
  {%- if video_link != blank -%}
    <a href="{{ video_link }}" class="background-video__link" aria-label="Explore collection"></a>
  {%- endif -%}
  {%- if section.settings.video != blank -%}
    {%- assign video_html = section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2000x' -%}
    {{ video_html | replace: '<video', '<video playsinline' }}
  {%- else -%}
    <div style="color: #ffffff; font-family: sans-serif; text-align: center; z-index: 1;">
      <h3>Background Video</h3>
      <p>Please select a video file in the Theme Editor.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Background Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Select Video",
      "info": "This video will autoplay on a continuous loop without controls, filling the entire screen on both mobile and desktop."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Video Link",
      "info": "Clicking the background video will navigate to this link."
    }
  ],
  "presets": [
    {
      "name": "Background Video"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
