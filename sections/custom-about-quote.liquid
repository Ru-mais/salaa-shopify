{%- style -%}
  .custom-about-quote-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
  }

  .custom-about-quote__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .custom-about-quote__content {
    max-width: 800px;
    text-align: left;
    border-left: 3px solid {{ section.settings.text_color }};
    padding-left: 28px;
  }

  .custom-about-quote__text {
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 300;
    line-height: 1.5;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
    font-style: italic;
  }

  .custom-about-quote__author {
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.2em;
    font-weight: 600;
    opacity: 0.8;
  }
{%- endstyle -%}

<div class="custom-about-quote-{{ section.id }}">
  <div class="custom-about-quote__container">
    <div class="custom-about-quote__content">
      {%- if section.settings.quote != blank -%}
        <blockquote class="custom-about-quote__text">
          &ldquo;{{ section.settings.quote }}&rdquo;
        </blockquote>
      {%- endif -%}
      {%- if section.settings.author != blank -%}
        <div class="custom-about-quote__author">&mdash; {{ section.settings.author }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Quote Banner",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "True luxury is not about excess, but about harmony, precision, and soul."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author / Citation",
      "default": "VOGUE International"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4EFE6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A0E17"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "About Quote Banner"
    }
  ]
}
{% endschema %}
