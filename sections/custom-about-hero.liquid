{%- style -%}
  .custom-about-hero-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
  }

  .custom-about-hero__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .custom-about-hero__content {
    max-width: 760px;
    text-align: left;
    border-left: 2px solid {{ section.settings.text_color }};
    padding-left: 24px;
  }

  .custom-about-hero__subtitle {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 14px;
    opacity: 0.75;
    color: {{ section.settings.text_color }};
  }

  .custom-about-hero__title {
    font-size: clamp(30px, 4.5vw, 48px);
    color: {{ section.settings.text_color }};
    margin: 0 0 18px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-align: left;
  }

  .custom-about-hero__story {
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.65;
    opacity: 0.88;
    margin: 0;
    font-weight: 300;
    text-align: left;
  }

  .custom-about-hero__image-wrap {
    margin-top: 48px;
    border-radius: 4px;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 21 / 9;
    max-height: 480px;
    background-color: {{ section.settings.text_color | color_modify: 'alpha', 0.05 }};
  }

  .custom-about-hero__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{%- endstyle -%}

<div class="custom-about-hero-{{ section.id }}">
  <div class="custom-about-hero__container">
    <div class="custom-about-hero__content">
      {%- if section.settings.subtitle != blank -%}
        <span class="custom-about-hero__subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="custom-about-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.story != blank -%}
        <div class="custom-about-hero__story">
          {{ section.settings.story | newline_to_br }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="custom-about-hero__image-wrap">
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.title }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Heritage & Vision"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Uncompromising Craftsmanship"
    },
    {
      "type": "textarea",
      "id": "story",
      "label": "Story Narrative",
      "default": "Salaa creates timeless luxury garments handcrafted by master artisans. Driven by minimalism, proportion, and enduring quality."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase Image"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A0E17"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "About Hero Section"
    }
  ]
}
{% endschema %}
