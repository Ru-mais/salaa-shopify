{%- style -%}
  .custom-faq-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
  }

  .custom-faq__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .custom-faq__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .custom-faq__subtitle {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 8px;
    opacity: 0.8;
  }

  .custom-faq__title {
    font-size: clamp(26px, 3.5vw, 36px);
    color: {{ section.settings.text_color }};
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .custom-faq__list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .custom-faq__item {
    background-color: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .custom-faq__item[open] {
    border-color: {{ section.settings.text_color | color_modify: 'alpha', 0.4 }};
  }

  .custom-faq__summary {
    padding: 22px 28px;
    font-size: 17px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .custom-faq__summary::-webkit-details-marker {
    display: none;
  }

  .custom-faq__icon {
    font-size: 20px;
    transition: transform 0.3s ease;
    line-height: 1;
    font-weight: 300;
  }

  .custom-faq__item[open] .custom-faq__icon {
    transform: rotate(45deg);
  }

  .custom-faq__content {
    padding: 0 28px 24px;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.88;
    border-top: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.08 }};
    margin-top: 4px;
    padding-top: 18px;
  }
{%- endstyle -%}

<div class="custom-faq-{{ section.id }}">
  <div class="custom-faq__container">
    
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="custom-faq__header">
        {%- if section.settings.subtitle != blank -%}
          <div class="custom-faq__subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="custom-faq__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-faq__list">
      {%- for block in section.blocks -%}
        <details class="custom-faq__item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
          <summary class="custom-faq__summary">
            <span>{{ block.settings.question }}</span>
            <span class="custom-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="custom-faq__content">
            {{ block.settings.answer | newline_to_br }}
          </div>
        </details>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Luxury FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Common Assistance"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#F4EFE6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4A0E17"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What are your shipping and white-glove delivery timelines?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Standard domestic orders arrive within 3-5 business days. Express white-glove delivery is available for same-day dispatch on select metropolitan orders."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury FAQ Section",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What are your shipping and white-glove delivery timelines?",
            "answer": "Standard domestic orders arrive within 3-5 business days. Express white-glove delivery is available for same-day dispatch on select metropolitan orders."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I schedule a private atelier consultation?",
            "answer": "Private appointments can be reserved directly through our concierge team by email or phone. We offer both virtual and in-person viewings."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "Complimentary returns and exchanges are accepted within 30 days of receipt for unused items in original packaging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
