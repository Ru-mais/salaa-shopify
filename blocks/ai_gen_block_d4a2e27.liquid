{% doc %}
  @prompt
    create a marquee that moves slows toward right , transform: rotate(2deg)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
    transform: rotate(2deg);
  }

  .ai-marquee-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.duration }}s linear infinite;
    will-change: transform;
  }

  .ai-marquee-{{ ai_gen_id }}__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .ai-marquee-{{ ai_gen_id }}__item {
    display: inline-flex;
    align-items: center;
    padding: 0 {{ block.settings.item_spacing }}px;
    white-space: nowrap;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-marquee-{{ ai_gen_id }}__separator {
    font-size: 0.7em;
    opacity: 0.7;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-{{ ai_gen_id }}__track {
      animation: none;
      transform: none;
    }
  }
{% endstyle %}

<div class="ai-marquee-{{ ai_gen_id }}" role="region" aria-label="{{ block.settings.accessible_label | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-{{ ai_gen_id }}__track" aria-hidden="true">
    {% for copy in (1..2) %}
      <div class="ai-marquee-{{ ai_gen_id }}__group">
        {% for item in (1..4) %}
          <span class="ai-marquee-{{ ai_gen_id }}__item">{{ block.settings.marquee_text | escape }}<span class="ai-marquee-{{ ai_gen_id }}__separator" aria-hidden="true">{{ block.settings.separator }}</span></span>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling marquee",
  "settings": [
    { "type": "text", "id": "marquee_text", "label": "Marquee text", "default": "A considered collection, made to last" },
    { "type": "text", "id": "accessible_label", "label": "Accessible label", "default": "Store announcement" },
    { "type": "text", "id": "separator", "label": "Separator", "default": "✦" },
    { "type": "range", "id": "duration", "label": "Scroll duration", "min": 20, "max": 100, "step": 5, "unit": "s", "default": 60 },
    { "type": "range", "id": "item_spacing", "label": "Item spacing", "min": 16, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#121212" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Scrolling marquee" }],
  "tag": null,
  "class": "ai-marquee-block"
}
{% endschema %}